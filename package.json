{
    "name":  "o-mestre-mandou",
    "private":  true,
    "version":  "0.1.0",
    "packageManager":  "pnpm@10.18.3",
    "scripts":  {
                    "dev":  "tsx scripts/dev.ts",
                    "api":  "tsx apps/api/src/main.ts",
                    "web":  "next dev apps/web",
                    "worker":  "tsx apps/api/src/worker.ts",
                    "build":  "next build apps/web",
                    "typecheck":  "tsc --noEmit",
                    "test":  "tsx --test tests/*.test.ts",
                    "lint":  "eslint .",
                    "check":  "pnpm lint \u0026\u0026 pnpm typecheck \u0026\u0026 pnpm test",
                    "sync-catalog":  "tsx scripts/catalog.ts",
                    "db-migrate":  "tsx scripts/db-migrate.ts",
                    "db-verify":  "tsx scripts/db-verify.ts",
                    "test-postgres":  "tsx --test tests/postgres.integration.ts",
                    "import-local":  "tsx scripts/import-local.ts",
                    "build:api":  "tsc -p tsconfig.netlify.json \u0026\u0026 tsx scripts/reset-netlify-runtime.ts \u0026\u0026 pnpm --filter @elo/api deploy --prod --legacy --config.node-linker=hoisted .netlify-api/runtime \u0026\u0026 tsx scripts/prune-api-package.ts \u0026\u0026 tsx scripts/prepare-netlify.ts",
                    "build:netlify":  "pnpm build:api \u0026\u0026 pnpm build",
                    "netlify-env":  "tsx scripts/netlify-env.ts",
                    "admin-promote":  "tsx scripts/admin-promote.ts",
                    "demo-access":  "tsx scripts/demo-access.ts"
                },
    "dependencies":  {
                         "@electric-sql/pglite":  "^0.3.14",
                         "@nestjs/common":  "^11.1.6",
                         "@nestjs/core":  "^11.1.6",
                         "@nestjs/platform-express":  "^11.1.6",
                         "argon2":  "^0.44.0",
                         "bullmq":  "^5.61.0",
                         "cookie-parser":  "^1.4.7",
                         "dotenv":  "^17.2.3",
                         "express":  "^5.3.0",
                         "jsonwebtoken":  "^9.0.2",
                         "lucide-react":  "^0.468.0",
                         "next":  "^16.0.0",
                         "pg":  "^8.16.3",
                         "react":  "^19.2.0",
                         "react-dom":  "^19.2.0",
                         "reflect-metadata":  "^0.2.2",
                         "rxjs":  "^7.8.2",
                         "serverless-http":  "^4.0.0",
                         "zod":  "^4.1.12"
                     },
    "devDependencies":  {
                            "@netlify/functions":  "^6.0.2",
                            "@types/cookie-parser":  "^1.4.9",
                            "@types/express":  "^5.0.3",
                            "@types/jsonwebtoken":  "^9.0.10",
                            "@types/node":  "^24.7.0",
                            "@types/pg":  "^8.15.5",
                            "@types/react":  "^19.2.0",
                            "@types/react-dom":  "^19.2.0",
                            "eslint":  "^9.37.0",
                            "tsx":  "^4.20.6",
                            "typescript":  "^5.9.3",
                            "typescript-eslint":  "^8.46.0"
                        }
}
