PORT=4000
WEB_ORIGIN=http://localhost:3000
APP_URL=http://localhost:3000
DEMO_MODE=true
DATABASE_MODE=postgres
DATA_DIR=.data/postgres
DATABASE_URL=postgresql://postgres.catfliwcaezqtgakaxwa:PREENCHA_NO_ENV@aws-1-ca-central-1.pooler.supabase.com:5432/postgres
# Supabase: use a URI do Session pooler (IPv4), não a URL da API HTTP.
# DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA_CODIFICADA@HOST_SESSION_POOLER:5432/postgres
DATABASE_SCHEMA=elo_demo
DATABASE_SSL=verify-full
# Supabase exige TLS verificado automaticamente. Use o CA oficial se necessário.
DATABASE_CA_FILE=.tools/supabase-ca.crt
DATABASE_POOL_MAX=6
DATABASE_MIGRATE=false
DATABASE_RUNTIME_ROLE=elo_runtime
# Demonstração local: elo_demo. Produção: elo com DEMO_MODE=false.
# Após db-migrate: DATABASE_MIGRATE=false, DATABASE_RUNTIME_ROLE=elo_runtime
# DATABASE_RUNTIME_ROLE=elo_runtime
# REDIS_URL=redis://localhost:6379
# Required in production: independently generated secrets, at least 32 characters.
# JWT_SECRET=
# PAYMENT_WEBHOOK_SECRET=
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=elo
